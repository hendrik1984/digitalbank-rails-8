<nav class="bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
    <div>
      <span class="text-lg font-bold text-gray-900">
        <%= link_to "Digital Bank", root_path %>
      </span>
    </div>

    <% if user_signed_in? %>
      <div class="flex items-center gap-4">
        <% if current_user.admin? %>
          <%= link_to "Admin",
              admin_root_path,
              class: "mt-1 text-sm font-medium text-gray-700 hover:text-blue-600" %>
        <% end %>

        <div class="relative" data-controller="dropdown">
          <button
            type="button"
            data-action="click->dropdown#toggle"
            class="text-sm text-gray-600 hover:text-blue-600 cursor-pointer"
          >
            <%= current_user.email %>
          </button>

          <div
            data-dropdown-target="menu"
            class="hidden absolute right-0 mt-2 w-48 rounded-md bg-white shadow-lg ring-1 ring-black/5 z-50"
          >
            <div class="py-1">
              <%= link_to "Profile",
                    profile_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
            </div>
          </div>
        </div>

        <%= button_to "Sign out",
              destroy_user_session_path,
              method: :delete,
              class: "rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 cursor-pointer" %>
      </div>
    <% else %>
      <div>
        <%= link_to "Sign in",
              new_user_session_path,
              class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</nav>
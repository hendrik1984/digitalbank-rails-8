<div class="min-h-screen bg-gray-100 px-4 py-10">
  <div class="max-w-xl mx-auto">
    <div class="bg-white rounded-lg shadow-md p-8">
      <h1 class="text-2xl font-bold text-gray-900">
        Open Bank Account
      </h1>

      <p class="mt-2 text-sm text-gray-600">
        Create a new bank account
      </p>

      <%= form_with model: @account do |form| %>
        <div class="mt-6">
          <%= form.label :currency, class: "block text-sm font-medium text-gray-700" %>

          <%= form.select :currency, 
              [["Indonesian Rupiah (IDR)", "IDR"]], 
              {}, 
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>

        <div class="mt-6">
          <%= form.submit "Create Account", class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
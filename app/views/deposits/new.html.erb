<div class="max-w-xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">
      Deposit Money
    </h1>

    <p class="mt-1 text-sm text-gray-600">
      Deposit money into account
      <span class="font-bold">
        <%= @account.account_number %>
      </span>
    </p>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <%= form_with model: [@account, @deposit] do |form| %>

      <% if @deposit.errors.any? %>
        <div class="mb-5 rounded-md bg-red-50 p-4">
          <ul class="list-disc pl-5 text-sm text-red-700">
            <% @deposit.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-5">
        <%= form.label :payment_method_code,
              "Payment Method",
              class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= form.select :payment_method_code,
              @payment_methods["payment_methods"].map {|u| [u["name"], u["code"]]},
              { prompt: "Select payment method" },
              {
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500"
              } %>
      </div>
      
      <div class="mb-5">
        <%= form.label :amount,
              "Amount",
              class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= form.number_field :amount,
              min: 0.01,
              step: 0.01,
              placeholder: "Enter deposit amount",
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

      <div>
        <%= form.submit "Deposit",
              class: "w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 cursor-pointer" %>
      </div>

    <% end %>
  </div>
</div>